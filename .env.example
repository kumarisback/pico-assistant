# Copy to .env and fill in. .env is gitignored.

# Shared secret the ESP32 and clients send in the hello frame.
# Generate one:  head -c 24 /dev/urandom | base64
ASSISTANT_TOKEN=change-me

# Override only if llama-server runs somewhere other than localhost:8081.
# LLAMA_BASE_URL=http://127.0.0.1:8081/v1
